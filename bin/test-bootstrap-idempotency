#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "${SELF_DIR}/.." && pwd)"
BOOTSTRAP="${ROOT}/bin/bootstrap"

TMP_DIR="$(mktemp -d /tmp/ai-counsel-bootstrap-test.XXXXXX)"
PROJECT_DIR="${TMP_DIR}/project"
mkdir -p "${PROJECT_DIR}"
trap 'rm -rf "${TMP_DIR}"' EXIT

echo "[test] temp project: ${PROJECT_DIR}"

common_flags=(
  "${PROJECT_DIR}"
  --yes
  --skip-vendor
  --skip-build
  --skip-wrapper
  --skip-auth-import
)

echo "[test] first run"
"${BOOTSTRAP}" "${common_flags[@]}"

expected_runtime_key="$(python3 - "${PROJECT_DIR}" <<'PY'
import hashlib, os, re, sys
p = os.path.abspath(sys.argv[1])
base = os.path.basename(p.rstrip(os.sep)) or "project"
safe = re.sub(r"[^A-Za-z0-9._-]+", "-", base).strip("-") or "project"
h = hashlib.sha1(p.encode()).hexdigest()[:12]
print(f"{safe}-{h}")
PY
)"
expected_runtime_base="${PROJECT_DIR}/.cache/ai-counsel-mcp/${expected_runtime_key}"

for d in \
  "${expected_runtime_base}/codex" \
  "${expected_runtime_base}/gemini" \
  "${expected_runtime_base}/opencode/share" \
  "${expected_runtime_base}/opencode/config" \
  "${expected_runtime_base}/claude/dot_claude" \
  "${expected_runtime_base}/claude/claude_code" \
  "${expected_runtime_base}/gcloud"; do
  test -d "${d}" || { echo "[test][error] missing runtime dir: ${d}" >&2; exit 1; }
done

for f in \
  "${PROJECT_DIR}/.ai-counsel/config.yaml" \
  "${PROJECT_DIR}/.ai-counsel/env" \
  "${PROJECT_DIR}/.mcp.json" \
  "${PROJECT_DIR}/.codex/config.toml" \
  "${PROJECT_DIR}/.gemini/settings.json" \
  "${PROJECT_DIR}/opencode.json"; do
  test -f "${f}" || { echo "[test][error] missing file: ${f}" >&2; exit 1; }
done

snap() {
  (cd "${PROJECT_DIR}" && find . -type f ! -name '*.bak.*' -print0 | sort -z | xargs -0 shasum)
}

before="$(snap)"
echo "[test] second run (idempotency check)"
"${BOOTSTRAP}" "${common_flags[@]}"
after="$(snap)"

if [[ "${before}" != "${after}" ]]; then
  echo "[test][error] non-idempotent changes detected on second run" >&2
  exit 1
fi

echo "[test] force overwrite creates backups"
"${BOOTSTRAP}" "${common_flags[@]}" --clients claude --force

backup_count="$(find "${PROJECT_DIR}" -name '.mcp.json.bak.*' | wc -l | tr -d ' ')"
if [[ "${backup_count}" -lt 1 ]]; then
  echo "[test][error] expected backup file for forced overwrite" >&2
  exit 1
fi

echo "[test] dry-run does not mutate"
before_dry="$(snap)"
"${BOOTSTRAP}" "${common_flags[@]}" --dry-run
after_dry="$(snap)"
if [[ "${before_dry}" != "${after_dry}" ]]; then
  echo "[test][error] dry-run changed files" >&2
  exit 1
fi

echo "[test] PASS"
